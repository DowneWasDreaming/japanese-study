    "@types/node": "24.3.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.1.7"
  }
